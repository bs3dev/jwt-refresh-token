<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>Domain | Library for managing JWT access tokens and refresh tokens using Azure Cosmos DB</Description>
        <Version>$(PackageVersion)</Version>
        <Title>Domain | JWT Refresh Token with Cosmos DB</Title>
        <Authors>Bs3</Authors>
        <Copyright>bs3.dev</Copyright>
        <PackageProjectUrl>https://github.com/bs3dev/jwt-refresh-token</PackageProjectUrl>
        <RepositoryUrl>https://github.com/bs3dev/jwt-refresh-token</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.4" />
      <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.4" />
      <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.8.0" />
    </ItemGroup>

</Project>
